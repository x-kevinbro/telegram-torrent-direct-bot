PUBLIC_BASE_URL=https://uploads.uptunnel.dev
SITE_NAME=UpTunnel
SITE_KEY=change_me_access_key
QBIT_HOST=http://qbittorrent:8080
MAX_TORRENT_SIZE_GB=150
MAX_ACTIVE_DOWNLOADS=2
MIN_FREE_GB=2
LINK_EXPIRY_HOURS=24
DOWNLOAD_DIR=/downloads
DATABASE_PATH=/data/web.db

# Telegram completion notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Primary S3 target (optional — e.g. Oracle Object Storage free tier)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_AUTO_OFFLOAD=0

# Secondary S3 target for large files (optional — e.g. Cloudflare R2)
# A download whose TOTAL size exceeds S3_SPLIT_GB goes to this target.
# S3_SPLIT_GB also acts as the primary bucket's capacity guard: when
# primary usage + new download would exceed it, the download falls back here.
S3B_ENDPOINT=
S3B_REGION=auto
S3B_BUCKET=
S3B_ACCESS_KEY=
S3B_SECRET_KEY=
S3B_PUBLIC_URL=
S3_SPLIT_GB=20

# Oracle Object Storage events -> Telegram webhook (optional)
# Set a random secret, then point an OCI Notifications HTTPS subscription at
# https://your-domain/oci-events/<secret> (the endpoint auto-confirms the subscription).
OCI_HOOK_SECRET=
